<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Toolkit.Standalone</RootNamespace>
    <AssemblyName>TantrumsToolkitStandalone</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <CodePage>65001</CodePage>
    <ApplicationIcon>toolkit.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <!-- The features use Json.NET (MIT). HDT ships it to the plugin; standing alone, we bring it. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\libs\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The plugin assembly itself: its features run here on the standalone host seams. Its HDT
         references are never loaded, because nothing here touches Host\Hdt\ or Plugin. -->
    <ProjectReference Include="..\HsbgCardLookup\HsbgCardLookup.csproj">
      <Project>{E53BEEE6-D1E5-41EA-8F48-8D807F9E706D}</Project>
      <Name>HsbgCardLookup</Name>
      <!-- Always the Release plugin: a Debug build would start its HDT-only probes. -->
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MemSpike\Mem.cs"><Link>Reader\Mem.cs</Link></Compile>
    <Compile Include="..\MemSpike\Mono.cs"><Link>Reader\Mono.cs</Link></Compile>
    <Compile Include="GameReader.cs" />
    <Compile Include="HsWindow.cs" />
    <Compile Include="OverlayWindow.cs" />
    <Compile Include="StandaloneHost.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Shared.cs" />
    <Compile Include="ToolkitHost.cs" />
    <Compile Include="Watcher.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="toolkit.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
  <ItemGroup>
    <!-- The plugin's bundled data, where its code looks for it: next to the assembly, under data\. -->
    <None Include="..\HsbgCardLookup\data\**\*.json;..\HsbgCardLookup\data\**\*.png;..\HsbgCardLookup\data\**\*.jpg">
      <Link>data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
