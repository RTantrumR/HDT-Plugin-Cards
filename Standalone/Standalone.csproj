<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Toolkit.Standalone</RootNamespace>
    <AssemblyName>TantrumsToolkitStandalone</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <CodePage>65001</CodePage>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MemSpike\Mem.cs"><Link>Reader\Mem.cs</Link></Compile>
    <Compile Include="..\MemSpike\Mono.cs"><Link>Reader\Mono.cs</Link></Compile>
    <Compile Include="..\HsbgCardLookup\data\TribeTally.cs"><Link>Shared\TribeTally.cs</Link></Compile>
    <Compile Include="GameReader.cs" />
    <Compile Include="HsWindow.cs" />
    <Compile Include="MmrTable.cs" />
    <Compile Include="OverlayWindow.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\HsbgCardLookup\data\tiers\*.png"><Link>tiers\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\HsbgCardLookup\data\tribes\*.jpg"><Link>tribes\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
