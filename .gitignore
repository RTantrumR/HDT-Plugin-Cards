# HDT's own assemblies — referenced at build time only, not redistributed.
# Run .\setup.ps1 to copy them out of your local HDT install. Everything else in libs/
# (the WebP decoder closure) IS committed, because the plugin bundles it at runtime.
libs/HearthstoneDeckTracker.exe
libs/HearthDb.dll
libs/HearthMirror.dll
libs/Newtonsoft.Json.dll

